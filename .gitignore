# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated by tool/test_suites.dart for full test runs
/test_suites/

# Personal notes and specs, kept local only
/notes/

# Personal Claude Code instructions, kept local only
/CLAUDE.local.md

# Signing keys and their secrets, never committed, wherever they land in
# the repo (android/.gitignore covers android/ only). CI writes its
# keystore as android/release-ci.p12; `make release-act` reads .secrets.
*.jks
*.keystore
*.p12
*.pfx
/.secrets

# temp files/dir
.flutter_tool_state
